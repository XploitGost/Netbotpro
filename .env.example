# NetBotPro local runtime configuration
# Copy to .env only for local experiments. Do not commit real secrets.

NETBOT_HOST=127.0.0.1
NETBOT_PORT=8765

# Required for protected routes when you run the backend manually.
# start-local.ps1 and Electron desktop mode can generate secure random local tokens automatically.
NETBOT_LOCAL_TOKEN=change-this-to-a-long-random-local-token

# Comma-separated browser origins allowed to connect to HTTP/websocket APIs.
NETBOT_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Keep disabled unless this backend is intentionally acting as an authorized remote sensor.
NETBOT_REMOTE_ACCESS=0

# Optional comma-separated operator IPs/CIDRs allowed to reach remote dashboard APIs.
# Example: NETBOT_REMOTE_IP_ALLOWLIST=203.0.113.10,10.10.0.0/24
NETBOT_REMOTE_IP_ALLOWLIST=

# Capture policy. Metadata is the safe default.
NETBOT_CAPTURE_MODE=metadata
NETBOT_ALLOW_FULL_CAPTURE=0
NETBOT_PAYLOAD_CAPTURE=0
NETBOT_REDACT_SENSITIVE_DATA=1
NETBOT_RETENTION_DAYS=7
NETBOT_SAFE_USE_ACCEPTED=0

# Optional runtime directories.
NETBOT_CONFIG_DIR=
NETBOT_DATA_DIR=
NETBOT_LOG_DIR=
NETBOT_LOG_LEVEL=info

# Flow-aware processing lanes. Metrics contain counters and safe reasons only.
NETBOT_FLOW_WORKERS_ENABLED=true
NETBOT_FLOW_WORKER_COUNT=4
NETBOT_FLOW_WORKER_QUEUE_MAX=2000
NETBOT_FLOW_WORKER_OVERFLOW_POLICY=drop_oldest
NETBOT_FLOW_WORKER_SHUTDOWN_TIMEOUT_SEC=5
NETBOT_FLOW_WORKER_ERROR_THRESHOLD=25
NETBOT_FLOW_WORKER_SLOW_JOB_MS=100

# Bounded, redacted recent live summaries. TTL 0 uses capacity-only eviction.
NETBOT_LIVE_RING_ENABLED=true
NETBOT_LIVE_RING_PACKET_MAX=5000
NETBOT_LIVE_RING_FLOW_MAX=2000
NETBOT_LIVE_RING_ALERT_MAX=1000
NETBOT_LIVE_RING_EXPERT_MAX=1000
NETBOT_LIVE_RING_PROTOCOL_MAX=2000
NETBOT_LIVE_RING_AGENT_MAX=1000
NETBOT_LIVE_RING_OPS_MAX=1000
NETBOT_LIVE_RING_DEFAULT_QUERY_LIMIT=250
NETBOT_LIVE_RING_MAX_QUERY_LIMIT=2000
NETBOT_LIVE_RING_TTL_SECONDS=0

# Bounded batch persistence. Counters and health are exposed in Ops Snapshot.
NETBOT_PERSISTENCE_BATCH_ENABLED=true
NETBOT_PERSISTENCE_PACKET_BATCH_SIZE=500
NETBOT_PERSISTENCE_PACKET_FLUSH_MS=1000
NETBOT_PERSISTENCE_FLOW_BATCH_SIZE=250
NETBOT_PERSISTENCE_FLOW_FLUSH_MS=1500
NETBOT_PERSISTENCE_ALERT_BATCH_SIZE=100
NETBOT_PERSISTENCE_ALERT_FLUSH_MS=1000
NETBOT_PERSISTENCE_AGENT_BATCH_SIZE=100
NETBOT_PERSISTENCE_AGENT_FLUSH_MS=3000
NETBOT_PERSISTENCE_QUEUE_MAX=5000
NETBOT_PERSISTENCE_RETRY_MAX=3
NETBOT_PERSISTENCE_RETRY_BACKOFF_MS=250
NETBOT_PERSISTENCE_OVERFLOW_POLICY=drop_oldest
NETBOT_FLOW_PERSIST_BATCH_SIZE=100
NETBOT_FLOW_PERSIST_FLUSH_INTERVAL_SEC=0.5
NETBOT_FLOW_PERSIST_QUEUE_MAX_SIZE=2000
NETBOT_FLOW_PERSIST_MAX_RETRIES=3
NETBOT_FLOW_PERSIST_RETRY_BACKOFF_SEC=0.1
