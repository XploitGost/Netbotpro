# NetBotPro local runtime configuration
# Copy to .env only for local experiments. Do not commit real secrets.

NETBOT_HOST=127.0.0.1
NETBOT_PORT=8765

# Required for protected routes when you run the backend manually.
# start-local.ps1 and Electron desktop mode can generate secure random local tokens automatically.
NETBOT_LOCAL_TOKEN=change-this-to-a-long-random-local-token

# Comma-separated browser origins allowed to connect to HTTP/websocket APIs.
NETBOT_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Keep disabled unless this backend is intentionally acting as an authorized remote sensor.
NETBOT_REMOTE_ACCESS=0

# Optional comma-separated operator IPs/CIDRs allowed to reach remote dashboard APIs.
# Example: NETBOT_REMOTE_IP_ALLOWLIST=203.0.113.10,10.10.0.0/24
NETBOT_REMOTE_IP_ALLOWLIST=

# Capture policy. Metadata is the safe default.
NETBOT_CAPTURE_MODE=metadata
NETBOT_ALLOW_FULL_CAPTURE=0
NETBOT_PAYLOAD_CAPTURE=0
NETBOT_REDACT_SENSITIVE_DATA=1
NETBOT_RETENTION_DAYS=7
NETBOT_SAFE_USE_ACCEPTED=0

# Optional runtime directories.
NETBOT_CONFIG_DIR=
NETBOT_DATA_DIR=
NETBOT_LOG_DIR=
NETBOT_LOG_LEVEL=info

# Bounded batch persistence. Counters and health are exposed in Ops Snapshot.
NETBOT_PERSIST_BATCH_SIZE=100
NETBOT_PERSIST_FLUSH_INTERVAL_SEC=0.5
NETBOT_PERSIST_QUEUE_MAX_SIZE=5000
NETBOT_PERSIST_OVERFLOW_POLICY=drop_oldest
NETBOT_PERSIST_MAX_RETRIES=3
NETBOT_PERSIST_RETRY_BACKOFF_SEC=0.1
NETBOT_FLOW_PERSIST_BATCH_SIZE=100
NETBOT_FLOW_PERSIST_FLUSH_INTERVAL_SEC=0.5
NETBOT_FLOW_PERSIST_QUEUE_MAX_SIZE=2000
NETBOT_FLOW_PERSIST_MAX_RETRIES=3
NETBOT_FLOW_PERSIST_RETRY_BACKOFF_SEC=0.1
