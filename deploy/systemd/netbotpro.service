[Unit]
Description=NetBotPro API/UI Server
Documentation=https://github.com/XploitGost/Netbotpro
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=netbotpro
Group=netbotpro
WorkingDirectory=/opt/netbotpro
EnvironmentFile=/etc/netbotpro/netbotpro.env
ExecStart=/opt/netbotpro/.venv/bin/python -m uvicorn backend.app.main:app --host ${NETBOT_HOST} --port ${NETBOT_PORT}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/netbotpro /var/log/netbotpro

[Install]
WantedBy=multi-user.target

